# Bu fayl — namuna. Haqiqiy qiymatlarni:
#   • kompyuterda: shu papkada .env.local fayliga (git'ga tushmaydi)
#   • Vercel'da:   Project → Settings → Environment Variables ga yozing.
# Ikkalasi ham bo'sh bo'lsa sayt baribir ishlaydi, faqat ariza formasi
# "yuborilmadi" deb telefon va Telegram'ni taklif qiladi.

# Telegram bot tokeni: Telegram'da @BotFather → /newbot → bergan token
TELEGRAM_BOT_TOKEN=

# Arizalar keladigan chat ID'si:
#   1) botni xodimlar guruhiga qo'shing va guruhga istalgan xabar yozing
#   2) brauzerda oching: https://api.telegram.org/bot<TOKEN>/getUpdates
#   3) "chat":{"id": ...} dagi raqamni yozing (guruhlarda u -100 bilan boshlanadi)
# Bir nechta admin/guruh bo'lsa vergul bilan yozing, har biriga xabar boradi:
#   TELEGRAM_CHAT_ID=5061909214,123456789,-1001234567890
# (har bir admin avval botga kirib Start bosgan bo'lishi kerak)
TELEGRAM_CHAT_ID=
